; How the installer looks, written by nagare-customize's Installer tab from theme.json: change it there, or here by
; hand - the tab writes over this file when it saves. nagare.iss includes it in its [Setup] section.
WizardStyle=modern dark polar includetitlebar
WizardBackColor=#0a1226
WizardImageFile=theme\wizard-*.png
WizardSmallImageFile=theme\corner-*.png
WizardImageOpacity=255
WizardBackImageFile=theme\back-*.png
WizardBackImageFileDynamicDark=theme\back-*.png
WizardBackImageOpacity=255
SetupIconFile=theme\setup.ico
