# Text is normalised to LF in the repository and checked out as the platform likes; what must stay byte for byte is
# marked binary.
* text=auto

# Windows' own scripts and Inno Setup's keep CRLF.
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binaries: images, icons, and the PGO profile the release workflow builds from.
*.png binary
*.ico binary
*.profdata binary
